generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ceo
  marketing
  gerente_geral
  gerente_clientes
  gerente_lojistas
  gerente_motoboys
  lojista
  cliente
  motoboy
}

enum UserStatus {
  active
  blocked
  inactive
}

enum OwnerType {
  user
  store
  platform
  motoboy
}

enum WalletEntryType {
  credit
  debit
  refund
}

enum WalletEntryCategory {
  deposit
  withdrawal
  payment
  refund
  transfer
  penalty
}

enum StockType {
  internal
  api
}

enum OrderStatus {
  criado
  pago
  aguardando_motoboy
  enviado
  entregue
  cancelado
  rejeitado
}

enum PaymentMethod {
  credit_card
  debit_card
  pix
  money
  cash_on_delivery
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
}

enum AsaasChargeStatus {
  none
  pending
  received
  confirmed
  refunded
  chargeback
}

enum DeliveryStatus {
  pending
  assigned
  picked
  delivered
  cancelled
}

enum ReturnStatus {
  pending
  aguardando_confirmacao
  confirmado
}

enum PendingReturnAction {
  reassign
  cancel
}

enum PayoutStatus {
  pending
  released
  requested
  paid
  cancelled
}

enum PayoutRecipientType {
  store
  motoboy
}

enum PayoutGatewayProvider {
  manual
  asaas
  pagarme
  efi
}

enum WithdrawalStatus {
  pending
  approved
  paid
  rejected
}

enum WithdrawalRequestStatus {
  pending
  approved
  rejected
  processed
}

enum CustomerDebtStatus {
  pending
  collected
}

enum AppCashboxEntryType {
  income
  expense
  withdrawal
  deposit
  refund
}

enum AppCashboxSource {
  product_commission
  delivery_commission
  manual_deposit
  manual_withdrawal
  withdrawal_fee
  cancelled_order
  cancelled_delivery
  coupon_discount
  order_payment
  order_refund
  payout_paid
  store_payout_reserved
  motoboy_payout_reserved
}

enum DeliveryInvoiceStatus {
  issued
  cancelled
}

enum WalletAccessStatus {
  pending
  approved
  rejected
  expired
  revoked
}

enum CancelledBy {
  customer
  motoboy
  store
  admin
}

enum CancellationReasonCode {
  customer_request
  not_available
  store_closed
  store_busy
  motoboy_unavailable
  delivery_failed
  customer_unreachable
  address_invalid
  payment_issue
  wrong_order
  damaged_items
  motoboy_rejected
  store_rejected
  late_cancellation
  other
}

enum RefundStatus {
  pending
  processed
  failed
}

enum CouponType {
  store
  global
}

enum CouponDiscountType {
  percent
  fixed
}

enum ConversationKind {
  loja_cliente
  loja_motoboy
  motoboy_cliente
  loja_cliente_pre_compra
  suporte
}

enum SupportCategory {
  clientes
  lojistas
  motoboys
  geral
}

enum SupportStatus {
  aberto
  em_atendimento
  resolvido
}

enum ConversationContext {
  product
  user
}

enum MessageStatus {
  sent
  delivered
  read
}

enum NotificationType {
  system
  broadcast
  order
  chat
}

enum GamificationLevel {
  Bronze
  Prata
  Ouro
  Platina
  Diamante
  Lendario
}

enum SeasonalTheme {
  none
  natal
  pascoa
  junina
  halloween
}

enum StoreSubscriptionPlan {
  plan1
  plan2
  plan3
}

enum PlanChangeStatus {
  none
  pending
  approved
  rejected
}

enum OtpChannel {
  whatsapp
}

// Nota: GamificationLevel.Lendario sem acento — enums do Postgres não aceitam
// acentos com segurança. O rótulo "Lendário" é aplicado na camada de apresentação.

model User {
  id                String     @id @default(cuid())
  name              String
  email             String     @unique
  passwordHash      String
  role              Role?
  roles             Role[]     @default([cliente])
  activeRole        Role       @default(cliente)
  status            UserStatus @default(active)
  blockedAt         DateTime?
  blockedBy         String?
  blockReason       String?
  storeId           String?
  permissions       String[]   @default([])
  telefone          String?
  cpf               String?
  rg                String?
  dataNascimento    String?
  sexo              String?
  photo             String?
  bankInfoEncrypted String?
  bankInfo          Json?
  planId            String?
  verification      Json?
  asaas             Json?
  currentLocation   Json?
  isOnline          Boolean?   @default(false)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  addresses    Address[]
  ownedStores  Store[]   @relation("StoreOwner")
  orders       Order[]   @relation("CustomerOrders")

  @@index([status])
}

model Address {
  id           String  @id @default(cuid())
  userId       String
  label        String?
  street       String
  number       String
  neighborhood String
  city         String
  state        String
  cep          String
  latitude     String
  longitude    String
  isDefault    Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Store {
  id                   String    @id @default(cuid())
  ownerId              String
  name                 String
  address              String?
  street               String?
  number               String?
  neighborhood         String?
  city                 String?
  state                String?
  zip                  String?
  cnpj                 String?
  latitude             String?
  longitude            String?
  stockType            StockType @default(internal)
  apiConfig            Json?
  plan                 Int?      @default(1)
  planSince            DateTime? @default(now())
  planExpiresAt        DateTime?
  customCommissionRate Decimal?  @db.Decimal(5, 2)
  featuredBannerUrl    String?
  coverBannerUrl       String?
  operatingHours       Json?
  isOpen               Boolean   @default(true)
  isVerified           Boolean   @default(false)
  verification         Json?
  asaas                Json?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  owner      User       @relation("StoreOwner", fields: [ownerId], references: [id])
  products   Product[]
  categories Category[]
  orders     Order[]    @relation("StoreOrders")

  @@index([ownerId])
  @@index([plan])
  @@index([isVerified])
}

model Category {
  id        String   @id @default(cuid())
  storeId   String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products Product[]

  @@index([storeId])
}

model Product {
  id          String   @id @default(cuid())
  storeId     String
  name        String
  description String?
  price       Decimal  @db.Decimal(12, 2)
  quantity    Int      @default(0)
  image       String?
  images      String[] @default([])
  video       String?
  categoryId  String?
  subCategory String?
  tags        String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  store    Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category Category?   @relation(fields: [categoryId], references: [id])
  items    OrderItem[]

  @@index([storeId])
  @@index([categoryId])
}

model Order {
  id                String             @id @default(cuid())
  customerId        String
  storeId           String
  totalValue        Decimal            @db.Decimal(12, 2)
  subtotal          Decimal?           @db.Decimal(12, 2)
  deliveryFee       Decimal            @db.Decimal(12, 2)
  deliveryDistance  Float?             @default(0)
  status            OrderStatus        @default(criado)
  paymentMethod     PaymentMethod?
  debtCollected     Decimal?           @db.Decimal(12, 2)
  paymentStatus     PaymentStatus?     @default(pending)
  paymentId         String?
  asaasPaymentId    String?
  asaasChargeStatus AsaasChargeStatus? @default(none)
  walletApplied     Decimal?           @default(0) @db.Decimal(12, 2)
  cancellationId    String?
  idempotentKey     String?            @unique
  customerAddress   String?
  customerLatitude  Float?
  customerLongitude Float?
  storeAddress      String?
  storeLatitude     Float?
  storeLongitude    Float?
  routePolyline     String?
  routeWaypoints    Json?
  walletDistribution Json?
  deliveryId        String?
  storeRating       Int?
  storeComment      String?
  createdAt         DateTime           @default(now())
  acceptedAt        DateTime?
  cancelledAt       DateTime?
  updatedAt         DateTime           @updatedAt

  customer User        @relation("CustomerOrders", fields: [customerId], references: [id])
  store    Store       @relation("StoreOrders", fields: [storeId], references: [id])
  items    OrderItem[]

  @@index([storeId, createdAt])
  @@index([status, createdAt])
  @@index([customerId, createdAt])
  @@index([asaasPaymentId])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  price     Decimal @db.Decimal(12, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model Wallet {
  id               String    @id @default(cuid())
  owner            String
  ownerType        OwnerType
  balance          Decimal   @default(0) @db.Decimal(12, 2)
  totalIncome      Decimal   @default(0) @db.Decimal(12, 2)
  totalSpent       Decimal   @default(0) @db.Decimal(12, 2)
  blockedBalance   Decimal   @default(0) @db.Decimal(12, 2)
  availableBalance Decimal   @default(0) @db.Decimal(12, 2)
  pendingBalance   Decimal   @default(0) @db.Decimal(12, 2)
  platformFeeRate  Decimal?  @db.Decimal(5, 2)
  gamificationBenefits Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  entries WalletEntry[]

  @@unique([owner, ownerType])
  @@index([owner, ownerType])
}

model WalletEntry {
  id            String               @id @default(cuid())
  walletId      String
  type          WalletEntryType
  category      WalletEntryCategory?
  amount        Decimal              @db.Decimal(12, 2)
  reason        String
  paymentMethod String?
  relatedId     String?
  reference     String?
  createdAt     DateTime             @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
  @@index([relatedId])
}
