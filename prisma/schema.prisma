generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ceo
  marketing
  gerente_geral
  gerente_clientes
  gerente_lojistas
  gerente_motoboys
  lojista
  cliente
  motoboy
}

enum UserStatus {
  active
  blocked
  inactive
}

enum OwnerType {
  user
  store
  platform
  motoboy
}

enum WalletEntryType {
  credit
  debit
  refund
}

enum WalletEntryCategory {
  deposit
  withdrawal
  payment
  refund
  transfer
  penalty
}

enum StockType {
  internal
  api
}

enum OrderStatus {
  criado
  pago
  aguardando_motoboy
  enviado
  entregue
  cancelado
  rejeitado
}

enum PaymentMethod {
  credit_card
  debit_card
  pix
  money
  cash_on_delivery
  wallet
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
}

enum AsaasChargeStatus {
  none
  pending
  received
  confirmed
  refunded
  chargeback
}

enum DeliveryStatus {
  pending
  assigned
  picked
  delivered
  cancelled
}

enum ReturnStatus {
  pending
  aguardando_confirmacao
  confirmado
}

enum PendingReturnAction {
  reassign
  cancel
}

enum PayoutStatus {
  pending
  released
  requested
  paid
  cancelled
}

enum PayoutRecipientType {
  store
  motoboy
}

enum PayoutGatewayProvider {
  manual
  asaas
  pagarme
  efi
}

enum WithdrawalStatus {
  pending
  approved
  paid
  rejected
}

enum WithdrawalRequestStatus {
  pending
  approved
  rejected
  processed
}

enum CustomerDebtStatus {
  pending
  collected
}

enum AppCashboxEntryType {
  income
  expense
  withdrawal
  deposit
  refund
}

enum AppCashboxSource {
  product_commission
  delivery_commission
  manual_deposit
  manual_withdrawal
  withdrawal_fee
  cancelled_order
  cancelled_delivery
  coupon_discount
  order_payment
  order_refund
  payout_paid
  store_payout_reserved
  motoboy_payout_reserved
}

enum DeliveryInvoiceStatus {
  issued
  cancelled
}

enum WalletAccessStatus {
  pending
  approved
  rejected
  expired
  revoked
}

enum CancelledBy {
  customer
  motoboy
  store
  admin
}

enum CancellationReasonCode {
  customer_request
  not_available
  store_closed
  store_busy
  motoboy_unavailable
  delivery_failed
  customer_unreachable
  address_invalid
  payment_issue
  wrong_order
  damaged_items
  motoboy_rejected
  store_rejected
  late_cancellation
  other
}

enum RefundStatus {
  pending
  processed
  failed
}

enum CouponType {
  store
  global
}

enum CouponDiscountType {
  percent
  fixed
}

enum ConversationKind {
  loja_cliente
  loja_motoboy
  motoboy_cliente
  loja_cliente_pre_compra
  suporte
}

enum SupportCategory {
  clientes
  lojistas
  motoboys
  geral
}

enum SupportStatus {
  aberto
  em_atendimento
  resolvido
}

enum ConversationContext {
  product
  user
}

enum MessageStatus {
  sent
  delivered
  read
}

enum MessageSenderRole {
  loja
  lojista
  cliente
  motoboy
  suporte
}

enum NotificationType {
  system
  broadcast
  order
  chat
}

enum GamificationLevel {
  Bronze
  Prata
  Ouro
  Platina
  Diamante
  Lendario
}

enum SeasonalTheme {
  none
  natal
  pascoa
  junina
  halloween
}

enum StoreSubscriptionPlan {
  plan1
  plan2
  plan3
}

enum PlanChangeStatus {
  none
  pending
  approved
  rejected
}

enum OtpChannel {
  whatsapp
}

// Nota: GamificationLevel.Lendario sem acento — enums do Postgres não aceitam
// acentos com segurança. O rótulo "Lendário" é aplicado na camada de apresentação.

model User {
  id                String     @id @default(cuid())
  name              String
  email             String     @unique
  passwordHash      String
  role              Role?
  roles             Role[]     @default([cliente])
  activeRole        Role       @default(cliente)
  status            UserStatus @default(active)
  blockedAt         DateTime?
  blockedBy         String?
  blockReason       String?
  storeId           String?
  permissions       String[]   @default([])
  telefone          String?
  cpf               String?
  rg                String?
  dataNascimento    String?
  sexo              String?
  photo             String?
  bankInfoEncrypted String?
  bankInfo          Json?
  planId            String?
  verification      Json?
  asaas             Json?
  currentLocation   Json?
  isOnline          Boolean?   @default(false)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  addresses    Address[]
  ownedStores  Store[]   @relation("StoreOwner")
  orders       Order[]   @relation("CustomerOrders")
  consentLogs  ConsentLog[]
  pushSubscriptions PushSubscription[]

  @@index([status])
  @@index([storeId])
}

/// Recarga de saldo da carteira via Asaas (PIX/cartão). Fica 'pending' até o
/// webhook de pagamento confirmar — só então o saldo é creditado (via WalletEntry).
/// Evita crédito "fake": o dinheiro só entra na carteira após pagamento real.
model WalletTopup {
  id             String   @id @default(cuid())
  userId         String
  amount         Decimal  @db.Decimal(12, 2)
  method         String   // pix | credit_card | debit_card
  asaasPaymentId String?  @unique
  status         String   @default("pending") // pending | paid | failed | cancelled
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
}

/// Inscrição de Web Push (um device do usuário). Um usuário pode ter várias
/// (celular + navegador). O `endpoint` é único por device/navegador.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Address {
  id           String  @id @default(cuid())
  userId       String
  label        String?
  street       String
  number       String
  neighborhood String
  city         String
  state        String
  cep          String
  latitude     String
  longitude    String
  // PostGIS: coluna `geom` criada pelo script manual prisma/manual/postgis_geo.sql
  // (fora do schema de propósito). Ver Store.geom acima.
  isDefault    Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Store {
  id                   String    @id @default(cuid())
  ownerId              String
  name                 String
  address              String?
  street               String?
  number               String?
  neighborhood         String?
  city                 String?
  state                String?
  zip                  String?
  cnpj                 String?
  latitude             String?
  longitude            String?
  // PostGIS: coluna `geom geography(Point,4326)` existe no banco APÓS rodar o script
  // manual prisma/manual/postgis_geo.sql — NÃO fica no schema de propósito (evita que
  // migrate dev/deploy tente criá-la sem PostGIS). Lida via SQL bruto (dispatchGeo).
  stockType            StockType @default(internal)
  apiConfig            Json?
  plan                 Int?      @default(1)
  planSince            DateTime? @default(now())
  planExpiresAt        DateTime?
  customCommissionRate Decimal?  @db.Decimal(5, 2)
  featuredBannerUrl    String?
  coverBannerUrl       String?
  operatingHours       Json?
  isOpen               Boolean   @default(true)
  isVerified           Boolean   @default(false)
  verification         Json?
  asaas                Json?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  owner      User       @relation("StoreOwner", fields: [ownerId], references: [id])
  products   Product[]
  categories Category[]
  orders     Order[]    @relation("StoreOrders")
  apiKeys    StoreApiKey[]
  webhooks   StoreWebhook[]

  @@index([ownerId])
  @@index([plan])
  @@index([isVerified])
}

/// Chave de API de máquina por loja (integração de estoque). Guarda só o HASH;
/// a chave inteira é mostrada uma única vez na criação. `prefix` = parte visível.
model StoreApiKey {
  id         String    @id @default(cuid())
  storeId    String
  name       String
  prefix     String    @unique
  keyHash    String
  scopes     String[]  @default(["read", "write"]) // 'read' e/ou 'write'
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
}

/// Webhook do lojista: recebe eventos de mudança de estoque (POST assinado HMAC).
model StoreWebhook {
  id             String    @id @default(cuid())
  storeId        String
  url            String
  secret         String
  active         Boolean   @default(true)
  failureCount   Int       @default(0)
  lastStatus     Int?
  lastDeliveryAt DateTime?
  createdAt      DateTime  @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
}

model Category {
  id        String   @id @default(cuid())
  storeId   String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products Product[]

  @@index([storeId])
}

model Product {
  id          String   @id @default(cuid())
  storeId     String
  name        String
  description String?
  price       Decimal  @db.Decimal(12, 2)
  oldPrice    Decimal? @db.Decimal(12, 2)
  quantity    Int      @default(0)
  image       String?
  images      String[] @default([])
  video       String?
  categoryId  String?
  subCategory String?
  tags        String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  store    Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category Category?       @relation(fields: [categoryId], references: [id])
  items    OrderItem[]
  reviews  ProductReview[]

  @@index([storeId])
  @@index([categoryId])
}

model ProductReview {
  id        String   @id @default(cuid())
  productId String
  userId    String
  orderId   String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, userId, orderId])
  @@index([productId])
}

model Order {
  id                String             @id @default(cuid())
  customerId        String
  storeId           String
  totalValue        Decimal            @db.Decimal(12, 2)
  subtotal          Decimal?           @db.Decimal(12, 2)
  deliveryFee       Decimal            @db.Decimal(12, 2)
  deliveryDistance  Float?             @default(0)
  deliveryDuration  Int?               // segundos, da rota (RouteService)
  status            OrderStatus        @default(criado)
  paymentMethod     PaymentMethod?
  debtCollected     Decimal?           @db.Decimal(12, 2)
  paymentStatus     PaymentStatus?     @default(pending)
  paymentId         String?
  asaasPaymentId    String?
  asaasChargeStatus AsaasChargeStatus? @default(none)
  walletApplied     Decimal?           @default(0) @db.Decimal(12, 2)
  cancellationId    String?
  idempotentKey     String?            @unique
  customerAddress   String?
  customerLatitude  Float?
  customerLongitude Float?
  storeAddress      String?
  storeLatitude     Float?
  storeLongitude    Float?
  routePolyline     String?
  routeWaypoints    Json?
  walletDistribution Json?
  deliveryId        String?
  storeRating       Int?
  storeComment      String?
  createdAt         DateTime           @default(now())
  acceptedAt        DateTime?
  cancelledAt       DateTime?
  updatedAt         DateTime           @updatedAt
  awaitingCustomerPoolDecision Boolean @default(false)
  installmentCount  Int?
  cardChargedTotal  Decimal?           @db.Decimal(12, 2)
  installmentValue  Decimal?           @db.Decimal(12, 2)

  customer User        @relation("CustomerOrders", fields: [customerId], references: [id])
  store    Store       @relation("StoreOrders", fields: [storeId], references: [id])
  items    OrderItem[]

  @@index([storeId, createdAt])
  @@index([status, createdAt])
  @@index([customerId, createdAt])
  @@index([asaasPaymentId])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  price     Decimal @db.Decimal(12, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model Wallet {
  id               String    @id @default(cuid())
  owner            String
  ownerType        OwnerType
  balance          Decimal   @default(0) @db.Decimal(12, 2)
  totalIncome      Decimal   @default(0) @db.Decimal(12, 2)
  totalSpent       Decimal   @default(0) @db.Decimal(12, 2)
  blockedBalance   Decimal   @default(0) @db.Decimal(12, 2)
  availableBalance Decimal   @default(0) @db.Decimal(12, 2)
  pendingBalance   Decimal   @default(0) @db.Decimal(12, 2)
  platformFeeRate  Decimal?  @db.Decimal(5, 2)
  gamificationBenefits Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  entries WalletEntry[]

  // @@unique já provê o índice de [owner, ownerType]; sem @@index duplicado
  // (evita custo de escrita à toa nesta tabela quente).
  @@unique([owner, ownerType])
}

model WalletEntry {
  id            String               @id @default(cuid())
  walletId      String
  type          WalletEntryType
  category      WalletEntryCategory?
  amount        Decimal              @db.Decimal(12, 2)
  reason        String
  paymentMethod String?
  relatedId     String?
  reference     String?
  createdAt     DateTime             @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
  @@index([relatedId])
}

model Delivery {
  id                        String              @id @default(cuid())
  orderId                   String
  motoboyId                 String?
  distance                  Float               @default(0)
  fee                       Decimal             @db.Decimal(12, 2)
  status                    DeliveryStatus      @default(pending)
  pin                       String?
  pinRetirada               String?
  pinDevolucao              String?
  statusDevolucao           ReturnStatus?       @default(pending)
  dataConfirmacaoDevolucao  DateTime?
  pendingReturnAction       PendingReturnAction?
  rating                    Int?
  comment                   String?
  storeAddress              String?
  storeLatitude             Float?
  storeLongitude            Float?
  // PostGIS: coluna `storeGeom` (ponto da loja p/ ST_DWithin do dispatch) criada pelo
  // script manual prisma/manual/postgis_geo.sql — fora do schema. Ver Store.geom.
  customerAddress           String?
  customerLatitude          Float?
  customerLongitude         Float?
  routePolyline             String?
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt
  cancelledAt               DateTime?

  @@index([orderId])
  @@index([motoboyId])
  // Composto p/ a query mais quente: pool de disponíveis
  // (status='pending' AND motoboyId IS NULL). Cobre status-só via prefixo.
  @@index([status, motoboyId])
}

model Transaction {
  id                 String        @id @default(cuid())
  orderId            String
  paymentMethod      String
  amount             Decimal       @db.Decimal(12, 2)
  commissionProduct  Decimal       @db.Decimal(12, 2)
  commissionDelivery Decimal       @db.Decimal(12, 2)
  createdAt          DateTime      @default(now())

  @@index([orderId])
}

model Payout {
  id                  String                @id @default(cuid())
  recipientType       PayoutRecipientType
  recipientId         String
  orderId             String
  deliveryId          String?
  amount              Decimal               @db.Decimal(12, 2)
  currency            String                @default("BRL")
  status              PayoutStatus          @default(pending)
  releasedAt          DateTime?
  requestedAt         DateTime?
  paidAt              DateTime?
  cancelledAt         DateTime?
  cancelReason        String?
  gatewayProvider     PayoutGatewayProvider @default(manual)
  gatewayTransferId   String?
  withdrawalRequestId String?
  blocked             Boolean               @default(false)
  blockReason         String?
  blockedAt           DateTime?
  blockedBy           String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@index([recipientType, recipientId, status])
  @@index([orderId])
  @@index([status, releasedAt])
  @@index([withdrawalRequestId])
}

model Withdrawal {
  id             String           @id @default(cuid())
  appCashboxId   String
  amount         Decimal          @db.Decimal(12, 2)
  status         WithdrawalStatus @default(pending)
  bankInfo       Json?
  requestedAt    DateTime         @default(now())
  approvedAt     DateTime?
  paidAt         DateTime?
  rejectedAt     DateTime?
  processedBy    String?
  rejectionReason String?
  reason         String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([appCashboxId, status])
  @@index([requestedAt])
  @@index([status])
}

model WithdrawalRequest {
  id             String                  @id @default(cuid())
  motoboyId      String
  motoboyName    String
  motoboyEmail   String
  amount         Decimal                 @db.Decimal(12, 2)
  status         WithdrawalRequestStatus @default(pending)
  bankAccount    Json?
  requestedAt    DateTime                @default(now())
  approvedAt     DateTime?
  approvedBy     String?
  rejectionReason String?
  processedAt    DateTime?
  transactionId  String?
  payoutIds      String[]                @default([])

  @@index([motoboyId])
  @@index([status])
}

model CustomerDebt {
  id               String             @id @default(cuid())
  customerId       String
  amount           Decimal            @db.Decimal(12, 2)
  sourceOrderId    String
  collectedOrderId String?
  status           CustomerDebtStatus @default(pending)
  reason           String
  createdAt        DateTime           @default(now())
  collectedAt      DateTime?
  updatedAt        DateTime           @updatedAt

  @@index([customerId, status])
}

model AppCashbox {
  id            String            @id @default(cuid())
  balance       Decimal           @default(0) @db.Decimal(12, 2)
  totalIncome   Decimal           @default(0) @db.Decimal(12, 2)
  totalExpenses Decimal           @default(0) @db.Decimal(12, 2)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  entries AppCashboxEntry[]
}

model AppCashboxEntry {
  id           String              @id @default(cuid())
  appCashboxId String
  type         AppCashboxEntryType
  source       AppCashboxSource
  amount       Decimal             @db.Decimal(12, 2)
  orderId      String?
  deliveryId   String?
  withdrawalId String?
  reason       String?
  createdAt    DateTime            @default(now())

  appCashbox AppCashbox @relation(fields: [appCashboxId], references: [id], onDelete: Cascade)

  @@index([appCashboxId, createdAt])
  @@index([orderId])
  @@index([deliveryId])
}

model DeliveryInvoice {
  id                 String                @id @default(cuid())
  invoiceNumber      String                @unique
  orderId            String
  deliveryId         String
  payoutId           String?
  motoboyId          String
  motoboyName        String
  motoboyEmail       String?
  motoboyCpf         String?
  storeId            String
  storeName          String
  storeAddress       String?
  storeCnpj          String?
  customerId         String
  customerName       String
  customerAddress    String?
  serviceDescription String                @default("Servico de entrega rapida por motoboy")
  distance           Float?
  deliveryFee        Decimal               @db.Decimal(12, 2)
  motoboyAmount      Decimal               @db.Decimal(12, 2)
  appCommission      Decimal               @db.Decimal(12, 2)
  commissionPercent  Decimal               @db.Decimal(5, 2)
  pickedAt           DateTime?
  deliveredAt        DateTime?
  issuedAt           DateTime              @default(now())
  status             DeliveryInvoiceStatus @default(issued)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@index([motoboyId, issuedAt])
  @@index([orderId])
  @@index([deliveryId])
  @@index([storeId, issuedAt])
}

model Cancellation {
  id                  String                 @id @default(cuid())
  orderId             String
  deliveryId          String?
  cancelledBy         CancelledBy
  reason              String
  reasonCode          CancellationReasonCode
  details             String?
  refundAmount        Decimal?               @db.Decimal(12, 2)
  refundStatus        RefundStatus?          @default(pending)
  isLateCancellation  Boolean                @default(false)
  lateCancellationFee Decimal?               @db.Decimal(12, 2)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@index([orderId])
  @@index([deliveryId])
  @@index([cancelledBy])
  @@index([createdAt])
}

model Coupon {
  id            String             @id @default(cuid())
  code          String             @unique
  type          CouponType
  discountType  CouponDiscountType
  discountValue Decimal            @db.Decimal(12, 2)
  storeId       String?
  productIds    String[]           @default([])
  minOrderValue Decimal?           @db.Decimal(12, 2)
  maxUses       Int?
  usedCount     Int                @default(0)
  validFrom     DateTime
  validUntil    DateTime
  isActive      Boolean            @default(true)
  createdBy     String
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([storeId, isActive])
  @@index([type, isActive])
}

model WalletAccessRequest {
  id              String             @id @default(cuid())
  requestedBy     String
  requestedByRole Role
  targetUserId    String
  reason          String
  status          WalletAccessStatus @default(pending)
  expiresAt       DateTime?
  approvedAt      DateTime?
  rejectedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([targetUserId, status])
  @@index([requestedBy, createdAt])
}

model Conversation {
  id                 String               @id @default(cuid())
  type               ConversationKind
  supportCategory    SupportCategory?
  supportStatus      SupportStatus?       @default(aberto)
  participant1       Json
  participant2       Json
  orderId            String?
  deliveryId         String?
  relatedOrderNumber String?
  productId          String?
  conversationType   ConversationContext? @default(user)
  messageCount       Int                  @default(0)
  unreadCount        Int[]                @default([0, 0])
  isActive           Boolean              @default(true)
  isBlocked          Boolean[]            @default([false, false])
  isMuted            Boolean[]            @default([false, false])
  deletedBy          String[]             @default([])
  lastMessageAt      DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  messages Message[]

  @@index([orderId, type])
  @@index([lastMessageAt])
  @@index([deliveryId])
  @@index([productId])
}

model Message {
  id             String        @id @default(cuid())
  conversationId String
  senderId       String
  senderRole     MessageSenderRole
  senderName     String
  text           String
  attachments    Json?
  status         MessageStatus @default(sent)
  readAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
  @@index([conversationId, status])
}

model Notification {
  id          String           @id @default(cuid())
  userId      String
  message     String
  title       String?
  type        NotificationType @default(system)
  broadcastId String?
  read        Boolean          @default(false)
  createdAt   DateTime         @default(now())

  @@index([userId, createdAt])
  @@index([userId, read])
}

model Gamification {
  id          String            @id @default(cuid())
  userId      String            @unique
  points      Int               @default(0)
  totalPoints Int               @default(0)
  level       GamificationLevel @default(Bronze)
  badges      String[]          @default([])
  history     Json?
}

model RolePermissions {
  id                  String   @id @default(cuid())
  role                Role     @unique
  permissions         String[] @default([])
  notificationTargets Role[]   @default([])
  updatedBy           String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model PlatformConfig {
  id                          String        @id @default(cuid())
  commissionPlan1             Decimal       @default(10) @db.Decimal(5, 2)
  commissionPlan2             Decimal       @default(15) @db.Decimal(5, 2)
  commissionPlan3             Decimal       @default(5) @db.Decimal(5, 2)
  motoboyCutPerDelivery       Decimal       @default(5) @db.Decimal(12, 2)
  motoboyCutPerKm             Decimal       @default(1) @db.Decimal(12, 2)
  motoboyMinimumWithdraw      Decimal       @default(50) @db.Decimal(12, 2)
  motoboyCommissionPercent    Decimal       @default(20) @db.Decimal(5, 2)
  lateCancellationFeePercent  Decimal       @default(10) @db.Decimal(5, 2)
  lateCancellationMotoboyShare Decimal      @default(50) @db.Decimal(5, 2)
  cancelFeeCustomerPercent    Decimal       @default(10) @db.Decimal(5, 2)
  cancelFeeStorePercent       Decimal       @default(10) @db.Decimal(5, 2)
  cancelFeeMotoboyPercent     Decimal       @default(10) @db.Decimal(5, 2)
  storeAcceptTimeoutMin       Int           @default(10)
  poolTimeoutMin              Int           @default(15)
  customerAbsentWaitMin       Int           @default(15)
  autoApprovePayouts          Boolean       @default(false)
  autoApproveWithdrawals      Boolean       @default(false)
  seasonalTheme               SeasonalTheme @default(none)
  cardFeePercent               Decimal @default(2.99) @db.Decimal(5, 2)
  cardFeeFixed                 Decimal @default(0.49) @db.Decimal(12, 2)
  cardAnticipationMonthlyRate  Decimal @default(1.99) @db.Decimal(5, 2)
  cardInstallmentMaxCount      Int     @default(12)
  cardInstallmentMinValue      Decimal @default(5) @db.Decimal(12, 2)
  updatedBy                   String
  updatedAt                   DateTime      @updatedAt
}

model PricingPlan {
  id             String   @id @default(cuid())
  name           String   @unique
  commission     Decimal  @default(0) @db.Decimal(5, 2)
  motorcycleTaxes Json
  minWithdraw    Decimal  @default(0) @db.Decimal(12, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model StoreSubscription {
  id               String                @id @default(cuid())
  storeId          String                @unique
  storeName        String
  currentPlan      StoreSubscriptionPlan @default(plan1)
  requestedPlan    StoreSubscriptionPlan?
  planChangeStatus PlanChangeStatus      @default(none)
  requestedAt      DateTime?
  approvedAt       DateTime?
  approvedBy       String?
  rejectionReason  String?
  commissionRate   Decimal?              @default(10) @db.Decimal(5, 2)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
}

model SupportTicket {
  id             String          @id @default(cuid())
  conversationId String
  openedBy       Json
  assignedTo     Json?
  category       SupportCategory
  subject        String
  status         SupportStatus   @default(aberto)
  resolvedAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([category, status])
}

model Broadcast {
  id            String   @id @default(cuid())
  title         String
  body          String
  targetRoles   String[] @default([])
  createdBy     String
  deliveryCount Int      @default(0)
  sentAt        DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([sentAt])
}

model RankingPrize {
  id            String    @id @default(cuid())
  month         Int
  year          Int
  prizes        Json
  distributed   Boolean   @default(false)
  distributedAt DateTime?
  distributedBy String?
  createdBy     String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([month, year])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
}

model OtpCode {
  id        String     @id @default(cuid())
  userId    String
  channel   OtpChannel @default(whatsapp)
  e164      String
  codeHash  String
  attempts  Int        @default(0)
  expiresAt DateTime
  createdAt DateTime   @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
}

model WebhookEvent {
  id           String    @id @default(cuid())
  provider     String    @default("asaas")
  eventId      String    @unique
  event        String
  payload      Json?
  processed    Boolean   @default(false)
  processedAt  DateTime?
  processError String?
  receivedAt   DateTime  @default(now())

  @@index([provider])
  @@index([event])
  @@index([processed])
}

model PromoBanner {
  id        String   @id @default(cuid())
  title     String?
  imageUrl  String
  linkUrl   String?
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
}

model ConsentLog {
  id           String   @id @default(cuid())
  userId       String
  documentType String   // "terms" | "privacy"
  version      String
  acceptedAt   DateTime @default(now())
  ipAddress    String?
  userAgent    String?
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
